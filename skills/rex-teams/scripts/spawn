#!/bin/sh
# Start a subagent in a background Rex tab and tell it how to report back.
#
#   spawn --name NAME --cwd DIR --task-file FILE [--depth N] -- COMMAND...
#
# COMMAND starts any agent CLI. A {prompt} argument is replaced with the
# agent's first prompt; without one, the prompt goes last, which suits claude,
# codex, and pi. For example: -- gemini -i {prompt}. --depth is how many
# levels of subagents it may start below itself (default 0).
set -eu

usage() {
  echo "usage: spawn --name NAME --cwd DIR --task-file FILE [--depth N] -- COMMAND..." >&2
  exit 2
}

name='' cwd='' task_file='' depth=0
while [ $# -gt 0 ]; do
  case $1 in
    --name) name=$2; shift 2 ;;
    --cwd) cwd=$2; shift 2 ;;
    --task-file) task_file=$2; shift 2 ;;
    --depth) depth=$2; shift 2 ;;
    --) shift; break ;;
    *) usage ;;
  esac
done
if [ -z "$name" ] || [ -z "$cwd" ] || [ ! -f "$task_file" ] || [ ! -d "$cwd" ] || [ $# -eq 0 ]; then usage; fi
# The name becomes part of a folder name, so keep it plain.
case $name in *[!a-z0-9-]*) echo "spawn: use lowercase letters, digits, and dashes in --name" >&2; exit 2 ;; esac
case $depth in ''|*[!0-9]*) echo "spawn: --depth must be a number" >&2; exit 2 ;; esac

# REX_TEAMS_DEPTH is how many levels an agent may start below itself. Agents
# the user starts don't have it, so they have no limit. A subagent can't give
# its own subagents more depth than it has.
if [ -n "${REX_TEAMS_DEPTH:-}" ]; then
  [ "$REX_TEAMS_DEPTH" -gt 0 ] || {
    echo "spawn: your parent didn't allow you to start subagents; do the task yourself or report blocked" >&2
    exit 1
  }
  [ "$depth" -lt "$REX_TEAMS_DEPTH" ] || depth=$((REX_TEAMS_DEPTH - 1))
fi

scripts_dir=$(cd "$(dirname "$0")" && pwd)
cwd=$(cd "$cwd" && pwd)
# /tmp is writable from Codex's default sandbox, and is cleared on restart.
# Every parent shares this folder, so mktemp adds a random suffix that keeps
# two subagents with the same name apart.
mkdir -p /tmp/rex-teams/tasks
task_dir=$(mktemp -d "/tmp/rex-teams/tasks/$name-$(date +%Y%m%d-%H%M%S)-XXXX")
task_id=$(basename "$task_dir")

# The kickoff carries the naming rule itself. Rex tells new agents to name
# their session before doing anything else, which would come before prompt.md.
kickoff="You are a subagent. Never rename the Rex session; it belongs to the agent that started you. If asked to name your session, name your tab instead and keep the arrow: rex window rename \"↳ <name>\". Read $task_dir/prompt.md and follow it."

# Put the kickoff where COMMAND has {prompt}, or last.
placed=0
for arg do
  shift
  if [ "$arg" = '{prompt}' ]; then set -- "$@" "$kickoff"; placed=1; else set -- "$@" "$arg"; fi
done
[ "$placed" = 1 ] || set -- "$@" "$kickoff"

# Open the tab first: the report needs its ID. The agent takes seconds to
# start, so prompt.md exists by the time it reads it.
created=$(rex window new "↳ $name" -s "$REX_SESSION" -c "$cwd" --focus=false --keep-open --json -- \
  env REX_TEAMS_DEPTH="$depth" "$@")
window=$(printf '%s' "$created" | jq -r '.window_id')
block=$(printf '%s' "$created" | jq -r '.block_ids[0]')

if [ "$depth" -gt 0 ]; then
  nesting="You may start subagents of your own with the rex-teams skill, up to $depth level(s) below you. Report only after they have reported to you."
else
  nesting="Do this task yourself. You can't start subagents."
fi

# The notice spells out the parent's next steps, because a parent that
# compacted while the subagent worked may have lost the skill's instructions.
{ cat "$task_file"; cat <<EOF

---

## How to report back

You are a subagent. Another agent started you in a Rex terminal and is waiting for your report.
$nesting

When you finish, or when you are stuck on a question only the parent or user can answer:

1. Write $task_dir/result.md. Its first line must be exactly one of:
   STATUS: completed
   STATUS: failed
   STATUS: blocked
   Then write a short report: what you did, files you changed, how you verified it, and any question you need answered.
2. Notify the parent by running this command (put your status in place of STATUS):
   $scripts_dir/send $REX_SESSION $REX_BLOCK "$task_id STATUS. Read $task_dir/result.md. If it's completed and checks out, close this subagent with: rex window close -s $REX_SESSION $window. Then wait for any other subagents you started."
   If it fails with a sandbox or permission error, ask for permission to run it outside the sandbox.
3. Stop and wait. The parent or the user may send follow-ups into this terminal. Handle each one, then repeat steps 1 and 2. Overwrite result.md each time.

Don't notify the parent with progress updates. Notify it only when you finish or are blocked.
EOF
} > "$task_dir/prompt.md"

cat <<EOF
task_dir: $task_dir
tab: $window
message it: $scripts_dir/send $REX_SESSION $block "MESSAGE"
EOF
