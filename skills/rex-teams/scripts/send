#!/bin/sh
# Type a one-line message into another agent's Rex terminal and submit it.
#
#   send SESSION BLOCK MESSAGE
#
# SESSION is a session ID, such as $REX_SESSION. BLOCK is the block ID of the
# other agent's terminal (block:...). Labels can be renamed or repeated, so
# find the ID once with `rex session inspect` and send to that. The message
# arrives as
#   [from <your name>, who can't see this screen. Reply by running: <this script> <your session> <your block> "<reply>"] MESSAGE
# so the other agent knows who wrote and how to answer, even if it has never
# heard of this skill. Without "can't see this screen", agents tend to answer
# in their own pane, where nobody reads it.
set -eu
[ $# -eq 3 ] || { echo "usage: send SESSION BLOCK MESSAGE" >&2; exit 2; }
session=$1 block=$2 message=$3

case $block in
  block:*) ;;
  *) echo "send: BLOCK must be a block ID (block:...); find it with: rex session inspect \"\$REX_SESSION\" --json" >&2; exit 2 ;;
esac
# A newline would submit half the message.
case $message in
  *'
'*) echo "send: the message must be one line; put longer text in a file and send its path" >&2; exit 2 ;;
esac

# Name yourself by your pane's label when your tab is split into panes,
# otherwise by your tab's label. Fall back to your block ID if the tab still
# has Rex's default label ("Window 1a2b3c4d"). The name is only for reading.
from=$(rex session inspect "$REX_SESSION" --json |
  jq -r --arg b "$REX_BLOCK" '.windows[] | (.layers | map(.blocks[]) ) as $blocks
    | select(any($blocks[]; .block_id == $b))
    | if ($blocks | length) > 1 then ($blocks[] | select(.block_id == $b) | .label // empty) else .label end
    | select(test("^Window [0-9a-f]+$") | not)')
from=${from:-$REX_BLOCK}

rex send -s "$session" -b "$block" \
  "[from $from, who can't see this screen. Reply by running: $(cd "$(dirname "$0")" && pwd)/send $REX_SESSION $REX_BLOCK \"<reply>\"] $message"
# Codex can miss an Enter that arrives right after a long burst of text.
sleep 0.5
rex send-key -s "$session" -b "$block" enter
